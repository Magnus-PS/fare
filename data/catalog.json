    "org": {"label":"Organic preferred","cls":"r-org","why":"Not on either EWG list, so we default to organic."},
    "wild": {"label":"Wild-caught","cls":"r-wild","why":"Wild-caught: no farm antibiotics or feed additives, usually more omega-3."},
    "past": {"label":"Pasture-raised","cls":"r-past","why":"Pasture-raised or organic: outdoor access, no routine antibiotics."},
    "grass": {"label":"Grass-fed & finished","cls":"r-past","why":"Grass-fed and finished: no feedlot, better fat profile."},
    "dairy": {"label":"Organic grass-fed dairy","cls":"r-past","why":"Organic, grass-fed dairy: no added hormones, pasture access."},
    "pantry": {"label":"Organic pantry","cls":"r-org","why":"Organic staple: a small premium and it keeps."},
    "raw": {"label":"Raw honey","cls":"r-org","why":"Raw and unfiltered, from a farmer's market or the grocer. Local when you can."},
    "conv": {"label":"Conventional","cls":"r-flag","why":"Doesn't meet our sourcing rules. Allowed, but we'd rather buy organic or grass-fed when we can."}
